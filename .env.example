# Timezone
TZ=America/New_York

# Your local subnet — allows traffic to your LAN to bypass the VPN
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24

# WireGuard credentials — generate these from PIA (see README)
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_PUBLIC_KEY=your_public_key_here
WIREGUARD_ADDRESSES=10.x.x.x/32

# PIA WireGuard server endpoint
VPN_ENDPOINT_IP=x.x.x.x
VPN_ENDPOINT_PORT=1337

# PIA account credentials
PIA_USER=your_pia_username
PIA_PASS=your_pia_password

# PIA server details for port forwarding (must match the server above)
PIA_SERVER_CN=servernameCN        # e.g. zurich408
PIA_SERVER_VIP=10.x.x.x          # server's VIP/gateway IP
